# Copia este ficheiro para .env (que não entra no Git) e preenche o que precisares.

# ADR-009: chave da API da Anthropic, para gerar User Stories com IA.
# Sem chave, o sistema usa o adaptador falso: devolve um esboço fixo e não faz chamadas à rede.
ANTHROPIC_API_KEY=

# "anthropic" ou "falso". Vazio: "anthropic" se houver chave, senão "falso".
IA_ADAPTADOR=
